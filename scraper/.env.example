SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resilience layer (all optional; sensible defaults live in src/resilience/config.ts) ---

# Comma-separated proxy URLs (e.g. http://user:pass@host:port). If unset, no
# proxy rotation happens and the maxVideosPerRun cap is what keeps volume low.
# SCRAPER_PROXIES=

# Per-platform overrides, e.g. for youtube_shorts:
# RATE_LIMIT_YOUTUBE_SHORTS_MIN_DELAY_MS=1500
# RATE_LIMIT_YOUTUBE_SHORTS_MAX_DELAY_MS=3000
# RATE_LIMIT_YOUTUBE_SHORTS_MAX_PER_HOUR=400
# RATE_LIMIT_YOUTUBE_SHORTS_MAX_PER_RUN=300
# RATE_LIMIT_YOUTUBE_SHORTS_BLOCK_COOLDOWN_MS=1800000
# RATE_LIMIT_YOUTUBE_SHORTS_CIRCUIT_THRESHOLD=5
# Same pattern for TIKTOK / INSTAGRAM / TWITTER once those collectors exist.
